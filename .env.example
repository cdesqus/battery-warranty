# ==============================================================================
# Presales Monitoring System - Environment Configuration Template
# Rename this file to '.env' and adjust the variables for production security.
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=presales_db

# Fallback Full Database URL (For platforms like Heroku/Render)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presales_db

# Backend Express API Configuration
PORT=5000
NODE_ENV=production

# Frontend Nginx Settings
# Access the web app in your browser at: http://localhost:80
VITE_API_URL=/api
